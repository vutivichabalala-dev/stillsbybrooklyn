{
  "name": "GalleryInvite",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the Client record"
    },
    "gallery_id": {
      "type": "string",
      "description": "ID of the Gallery"
    },
    "invited_email": {
      "type": "string",
      "description": "Email the invite was sent to"
    },
    "invite_status": {
      "type": "string",
      "enum": [
        "sent",
        "accepted"
      ],
      "default": "sent"
    },
    "invited_at": {
      "type": "string",
      "description": "ISO timestamp when invite was sent"
    },
    "accepted_at": {
      "type": "string",
      "description": "ISO timestamp when client first logged in"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this invite",
      "maxLength": 1000
    }
  },
  "required": [
    "client_id",
    "gallery_id",
    "invited_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.invited_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}