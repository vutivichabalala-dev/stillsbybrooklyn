{
  "name": "GalleryImage",
  "type": "object",
  "properties": {
    "gallery_id": {
      "type": "string",
      "description": "ID of the parent gallery"
    },
    "image_url": {
      "type": "string",
      "description": "Full resolution image URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail URL for grid views"
    },
    "filename": {
      "type": "string",
      "description": "Original filename"
    },
    "image_type": {
      "type": "string",
      "enum": [
        "proof",
        "final"
      ],
      "default": "proof",
      "description": "Whether this is a proof or final edited image"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within gallery"
    },
    "image_status": {
      "type": "string",
      "enum": [
        "awaiting_selection",
        "selected_for_edit",
        "in_editing",
        "ready",
        "delivered"
      ],
      "default": "awaiting_selection",
      "description": "Editing workflow status for this image"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this image",
      "maxLength": 1000
    }
  },
  "required": [
    "gallery_id",
    "image_url",
    "filename",
    "image_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.gallery_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}