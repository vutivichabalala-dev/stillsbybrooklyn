{
  "name": "Reel",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Reel title"
    },
    "description": {
      "type": "string",
      "description": "Short caption or description"
    },
    "video_url": {
      "type": "string",
      "description": "Public URL of the uploaded video file"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Optional thumbnail/cover image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "Corporate",
        "Portraits",
        "Weddings",
        "Graduations",
        "Behind the Scenes",
        "Other"
      ],
      "description": "Reel category"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Pin to top of reels feed"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "video_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}