{
  "name": "Client",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Client full name"
    },
    "email": {
      "type": "string",
      "description": "Client email address (used to match after login)"
    },
    "phone": {
      "type": "string",
      "description": "Client phone number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Client status"
    },
    "invite_status": {
      "type": "string",
      "enum": [
        "not_invited",
        "invited",
        "accepted"
      ],
      "default": "not_invited",
      "description": "Invite status"
    },
    "invited_at": {
      "type": "string",
      "description": "ISO timestamp of when invite was sent"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about the client"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}